---
layout: layouts/base.njk
title: Forsiden
eleventyImport:
  collections: [articles]
---
<section class="home-list wrap" aria-labelledby="latest-title">
  <h1 class="sr-only" id="latest-title">Artikler</h1>
  <aside class="development-notice" aria-label="Utviklingsstatus">
    <strong>Konsept under utvikling</strong>
    <p>Bastant er under utvikling. Innhold, metode og utforming kan bli endret.</p>
  </aside>
  {% if collections.articles.length %}
    <div class="compact-list">
      {% for article in collections.articles | limit(7) %}
        {% include "components/compact-article.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <p class="empty-state">Ingen artikler er publisert ennå.</p>
  {% endif %}
</section>
