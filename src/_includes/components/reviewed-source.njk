{% set reviewedArticle = review | reviewDetails %}
<aside class="reviewed-source" aria-labelledby="review-source-title">
  <p class="reviewed-source__label" id="review-source-title">Artikkelen som gjennomgås</p>
  <h2>{{ reviewedArticle.name }}: «{{ review.title }}»</h2>
  <p class="reviewed-source__kind"><strong>{{ reviewedArticle.site }}</strong> · {{ reviewedArticle.type.name }}</p>
  <div class="reviewed-source__descriptions">
    <div>
      <h3>Om {{ reviewedArticle.site }}</h3>
      <p>{{ reviewedArticle.description }}</p>
    </div>
    <div>
      <h3>Om typen «{{ reviewedArticle.type.name }}»</h3>
      <p>{{ reviewedArticle.type.description }}</p>
    </div>
  </div>
  <dl>
    {% if reviewedArticle.hasExternalSource %}<div><dt>Innholdsprodusent</dt><dd>{{ reviewedArticle.source.name }}</dd></div>{% endif %}
    {% if review.published %}<div><dt>Publisert</dt><dd>{{ review.published | readableDate }}</dd></div>{% endif %}
    {% if review.updated %}<div><dt>Oppdatert</dt><dd>{{ review.updated | readableDate }}</dd></div>{% endif %}
    {% if review.accessed %}<div><dt>Kontrollert</dt><dd>{{ review.accessed | readableDate }}</dd></div>{% endif %}
  </dl>
  <a class="source-link" href="{{ review.url }}">Les originalartikkelen hos {{ reviewedArticle.name }} <span aria-hidden="true">↗</span></a>
</aside>
