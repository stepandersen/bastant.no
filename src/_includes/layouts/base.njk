<!doctype html>
<html lang="nb" data-theme="auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ metaDescription }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)">
    <title>{{ pageTitle }}</title>
    <link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ '/feed.xml' | url | absoluteUrl(site.url) }}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <script>
      (function(){try{var t=localStorage.getItem('bastant-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}})();
    </script>
    <link rel="stylesheet" href="/assets/css/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#innhold">Hopp til innholdet</a>
    <header class="site-header">
      <div class="site-header__inner wrap">
        <a class="wordmark" href="/" aria-label="Bastant – forsiden">
          <span>Bastant</span><span>.no</span>
        </a>
        <nav class="main-nav" aria-label="Hovedmeny">
          <a href="/artikler/"{% if page.url.startsWith('/artikler/') %} aria-current="page"{% endif %}>Artikler</a>
          <a href="/emner/"{% if page.url.startsWith('/emner/') %} aria-current="page"{% endif %}>Emner</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Bytt fargetema">
          <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
          <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.2A8 8 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"/></svg>
        </button>
      </div>
    </header>

    <main id="innhold">{{ content | safe }}</main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <a class="wordmark wordmark--small" href="/"><span>Bastant</span><span>.no</span></a>
          <p>{{ site.description }}</p>
        </div>
        <nav aria-label="Bunnmeny">
          <a href="/metode/">Metode</a>
          <a href="/medier/">Medier</a>
          <a href="/om/">Om bastant</a>
          <a href="/feed.xml">RSS</a>
        </nav>
      </div>
    </footer>
    <script src="/assets/js/theme.js" defer></script>
  </body>
</html>
